ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-sonnet-5
APP_ENV=development

GOOGLE_CLIENT_ID=your_google_oauth_web_client_id_here
GOOGLE_CLIENT_SECRET=your_google_oauth_web_client_secret_here

FRONTEND_ORIGIN=http://localhost:5173
FRONTEND_POST_AUTH_URL=http://localhost:5173
PUBLIC_BACKEND_URL=http://localhost:8000

SESSION_SECRET=replace_with_a_long_random_secret
SESSION_COOKIE_SECURE=false
SESSION_SAME_SITE=lax
SESSION_MAX_AGE_SECONDS=14400
ALLOW_INSECURE_OAUTH_TRANSPORT=true
REQUIRE_AUTH_FOR_ANALYSIS=false
ALLOW_ANONYMOUS_ANALYSIS=true
ANALYSIS_REQUESTS_PER_HOUR=15
MAX_CONCURRENT_ANALYSES=2
ENABLE_SLIDES=false
